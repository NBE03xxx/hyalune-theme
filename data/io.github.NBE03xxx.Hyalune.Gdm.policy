<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<policyconfig>
 <vendor>Hyalune</vendor>
 <action id="io.github.NBE03xxx.Hyalune.Gdm">
  <description>Manage the Hyalune login screen</description>
  <description xml:lang="ja">Hyaluneのログイン画面を管理</description>
  <message>Administrator authentication is required to manage the login screen.</message>
  <message xml:lang="ja">ログイン画面の管理には管理者認証が必要です。</message>
  <icon_name>io.github.NBE03xxx.Hyalune.Settings</icon_name>
  <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/hyalune-gdm-settings</annotate>
 </action>
</policyconfig>
